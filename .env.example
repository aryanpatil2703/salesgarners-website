# ========================================================
# SalesGarners Production Environment Configuration
# ========================================================

# MySQL connection (legacy website data): mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/salesgarners"

# --------------------------------------------------------
# PostgreSQL + pgvector (Docker Container)
# Matches docker-compose.yml defaults for turnkey setup:
# --------------------------------------------------------
POSTGRES_DB="salesgarners"
POSTGRES_USER="salesgarners_user"
POSTGRES_PASSWORD="salesgarners_secure_password"
PG_PORT="5435"

# Direct connection URI used by Next.js app to connect to Docker pgvector:
PG_CONNECTION_STRING="postgresql://salesgarners_user:salesgarners_secure_password@localhost:5435/salesgarners"

# --------------------------------------------------------
# AI Chatbot LLM Provider & Embedding Keys
# Provide either an OpenAI API key or a Gemini API key:
# --------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional model override (defaults: gpt-4o-mini or gemini-1.5-flash)
CHAT_MODEL=""

# --------------------------------------------------------
# Admin Dashboard Security
# --------------------------------------------------------
ADMIN_PASSWORD="change-me-to-a-strong-password"
SESSION_SECRET="replace-with-a-64-character-random-hex-string"

# Optional: Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=""
